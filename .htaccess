# --- Wildcard Redirects (WordPress leftovers) ---
RewriteRule ^wp-content/themes/hello-elementor/ / [R=301,L]
RewriteRule ^wp-content/themes/resiliency-theme/ / [R=301,L]
RewriteRule ^wp-content/plugins/ / [R=301,L]
RewriteRule ^wp-content/ / [R=301,L]
RewriteRule ^wp-includes/ / [R=301,L]
RewriteRule ^wp-.*\.php$ / [R=301,L]

# =============================================================================
# CLEAN URL ROUTING
# Strip .php extension from URLs and serve files without extension
# =============================================================================

# Redirect /page.php to /page (remove .php from browser URL)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
RewriteRule ^/?(.*)\\.php$ /$1 [L,R=301]

# Serve .php file if extensionless request matches a .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\\.php -f
RewriteRule ^(.*)$ $1.php [L]
